# ============================================
# 居家健身游戏平台 - 环境变量配置示例
# 使用方法: 复制此文件为 .env 并填入真实值
#           cp .env.example .env
# ============================================

# 小米 Mimo AI API (用于卡路里AI教练「卡卡」)
# 获取地址: https://token-plan-cn.xiaomimimo.com
MIMO_API_KEY=你的小米API密钥
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5
